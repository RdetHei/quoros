# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Quoros — Laravel 13 di Vercel (Vercel Services / container runtime)
#
# Base image: FrankenPHP = PHP 8.4 + web server Caddy di atas Debian Bookworm.
# Empat stage:
#   1. base         -> PHP + ekstensi yang dibutuhkan aplikasi
#   2. assets       -> npm ci + npm run build (Vite & Tailwind)
#   3. dependencies -> composer install produksi + aplikasi lengkap
#   4. runtime      -> image final yang dijalankan Vercel
# ---------------------------------------------------------------------------

# ---------- Stage 1: base (PHP + ekstensi) ----------
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

# gd wajib: phpoffice/phpword (dipakai fitur impor dokumen) mensyaratkan ext-gd.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_mysql gd

WORKDIR /app

# ---------- Stage 2: build aset front-end (Vite + Tailwind) ----------
# Stage terpisah supaya Node.js tidak ikut masuk ke image final.
FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---------- Stage 3: dependency PHP + aplikasi ----------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Dipisah agar layer ini ikut ter-cache selama composer.json/lock tidak berubah.
# --no-scripts karena aplikasi belum lengkap (baru composer.json saja).
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --optimize-autoloader \
        --prefer-dist

COPY . .

# Aset hasil `npm run build` dari stage 2.
COPY --from=assets /app/public/build ./public/build

# storage:link wajib: view memakai asset('storage/...') sementara doc root
# container adalah /app/public.
RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && php artisan storage:link \
    && composer dump-autoload --no-dev --classmap-authoritative

# ---------- Stage 4: runtime ----------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Nilai di bawah ini aman di-bake karena tidak bergantung kredensial.
# Variabel yang sensitif (APP_KEY, DB_*, CLOUDINARY_*) disuntikkan Vercel
# saat instance start — jangan di-hardcode di sini.
# Catatan: SESSION_DRIVER / CACHE_STORE sengaja TIDAK di-set di sini;
# biarkan Laravel memakai default "database" (lihat dokumentasi).
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
