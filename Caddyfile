{
	frankenphp
	order php_server before file_server
}

# Caddy mengikuti kontrak port Vercel ($PORT), default 80 untuk lokal.
:{$PORT:80} {
	# Document root dibatasi ke public/ agar config, .env, dan source
	# Laravel tidak bisa diakses dari luar.
	root * /app/public

	encode zstd gzip

	# Cache header untuk aset statis. Tanpa ini Caddy/Vercel memakai
	# "max-age=0, must-revalidate" sehingga browser revalidasi tiap navigasi.
	# Aset Vite sudah ber-hash -> aman di-cache selamanya.
	header /build/* Cache-Control "public, max-age=31536000, immutable"
	# Aset /storage hasil upload pengguna (cover, avatar, bab): nama file tidak
	# ber-hash, jadi cache 7 hari saja.
	header /storage/* Cache-Control "public, max-age=604800"
	# Aset statis milik repo dengan nama file tetap. Ditulis setelah /storage/*
	# supaya menang untuk path logo. Cache 1 tahun agar lolos audit
	# "efficient cache lifetime". Kalau isinya diganti, ganti juga nama filenya
	# supaya cache lama tidak terus dipakai.
	header /storage/logo/* Cache-Control "public, max-age=31536000, immutable"
	header /error.png Cache-Control "public, max-age=31536000, immutable"
	header /favicon.ico Cache-Control "public, max-age=604800"

	# File statis (aset Vite, /storage, dsb.) dilayani langsung;
	# sisanya diteruskan ke public/index.php.
	php_server {
		try_files {path} index.php
	}
}
